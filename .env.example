# ── إعدادات "أثر" ────────────────────────────────────────────────────────
# انسخ هذا الملف إلى .env ثم عدّل ما تحتاجه.
#
# التطبيق كله مجاني ومفتوح المصدر، ولا يحتاج أي مفتاح API ولا اشتراك.

# مزوّد التعرّف على الصور. القيمتان الممكنتان:
#
#   mock   → محاكاة محلية. الافتراضي. مجاني، بلا إنترنت، مناسب للتطوير
#            والعرض قبل أن تجهز صورك.
#
#   local  → تعرّف حقيقي داخل المتصفح بنموذج DINOv3. مجاني تمامًا.
#            يتطلب:
#              npm install @huggingface/transformers
#              + فهرس مرجعي في public/reference-index.json
#            يبنيه دفتر Kaggle مجانًا وبلا GPU — انظر notebooks/README.md
VITE_RECOGNITION_PROVIDER=mock
