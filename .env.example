# ── إعدادات "أثر" ────────────────────────────────────────────────────────
# انسخ هذا الملف إلى .env ثم عدّل ما تحتاجه.

# مزوّد التعرّف على الصور. القيم الممكنة:
#   mock   → محاكاة محلية. الافتراضي. مجاني، بلا إنترنت، مناسب للعرض.
#   local  → تعرّف حقيقي داخل المتصفح بـ DINOv3. مجاني. يتطلب:
#            npm install @huggingface/transformers
#            + فهرس مرجعي في public/reference-index.json (يبنيه دفتر Kaggle)
#            انظر notebooks/README.md
#   claude → تعرّف عبر Claude Vision خلف دالة خادمية.
#            ⚠️ يستهلك رصيد Anthropic API (منفصل عن اشتراك Claude Pro).
VITE_RECOGNITION_PROVIDER=mock

# مسار الدالة الخادمية لمزوّد claude (اتركه فارغًا للقيمة الافتراضية /api/recognize)
# VITE_RECOGNITION_ENDPOINT=/api/recognize

# ⚠️ لا تضع ANTHROPIC_API_KEY هنا إطلاقًا.
# أي متغيّر يبدأ بـ VITE_ يُحقن في حزمة المتصفح ويستطيع أي زائر قراءته.
# مفتاح Anthropic يوضع في بيئة الخادم فقط (Vercel → Settings → Environment Variables).
